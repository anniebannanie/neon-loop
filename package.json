{
  "name": "neon-loop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Neon Loop: run-of-show, live graphics and pledging for fundraising events.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
